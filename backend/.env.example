# ==============================================================================
# PROGENI ATLAS — BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# Copy to backend/.env and fill in real values. NEVER commit .env.
# Generate secrets:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
PORT=5000
# production on Vercel/Docker: APP_ENV=production
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=False

# ------------------------------------------------------------------------------
# 2. AUTH / JWT  (REQUIRED in production — the app refuses to boot without them)
# ------------------------------------------------------------------------------
# HS256 signing key for access/refresh tokens. SWAMI_SECRET_KEY is the canonical
# name; JWT_SECRET is accepted as a fallback for legacy deployments.
SWAMI_SECRET_KEY=
JWT_SECRET=
# Dedicated OTP pepper. Do NOT reuse the JWT secret for this in production —
# rotating the pepper invalidates every unconsumed OTP in the database.
OTP_PEPPER=
# Comma-separated list of allowed browser origins (your frontend domains).
# Production example: CORS_ORIGINS=https://atlas.progeni.live,https://www.progeni.live
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. SUPER-ADMIN BOOTSTRAP
# ------------------------------------------------------------------------------
# The super-admin account is ensured idempotently at every boot.
# If SUPER_ADMIN_PASSWORD is NOT set, a random one-time password is generated
# and logged once at first boot — set this explicitly for real deployments.
ADMIN_DEFAULT_EMAIL=admin@progeni.live
SUPER_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. DATABASE — MongoDB Atlas (REQUIRED) + Qdrant (optional, mock fallback)
# ------------------------------------------------------------------------------
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGODB_DB_NAME=progeni_atlas
# Qdrant Cloud: https://<cluster>.<region>.aws.cloud.qdrant.io + API key
# If unreachable the app boots with qdrant in "mock_fallback" mode.
QDRANT_URL=
QDRANT_API_KEY=
# Create indexes on boot when schema version is stale (default true)
# DB_CREATE_INDEXES=true
# Heavy one-time migrations (user dedup + package sync) at boot (default false).
# Better: run `python scripts/migrate_db.py` once manually instead.
# DB_MIGRATE_ON_BOOT=false

# ------------------------------------------------------------------------------
# 5. LLM — Gemini (primary) -> OpenAI -> OpenRouter (fallback chain)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_API=             # legacy alias, also accepted
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL  (OTP delivery, interview invites, decision emails)
# ------------------------------------------------------------------------------
# Industry standard: a transactional provider over HTTPS (works from serverless
# and cloud IPs, with delivery logs and bounce handling). Resend recommended:
#   1. Sign up at https://resend.com  (free tier: 3,000 emails/month)
#   2. Verify your sending domain (or use their onboarding sandbox to test)
#   3. Create an API key and set both vars below, then restart the backend.
RESEND_API_KEY=
# RESEND_FROM="Progeni Atlas <support@progeni.live>"
#
# Legacy fallback (only used when RESEND_API_KEY is unset): plain SMTP.
# Gmail: use an App Password (not the account password). Port 465 = SSL,
# 587 = STARTTLS. Not recommended for production — Gmail blocks logins from
# cloud/serverless IPs and caps daily sends.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Progeni Atlas
# SMTP_FROM="Progeni Atlas <no-reply@progeni.live>"

# ------------------------------------------------------------------------------
# 7. LIVEKIT WEBRTC  (server-only, never sent to the browser)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# 8. UPI PAYMENT GATEWAY  (Mayank Multi-Merchant UPI / pay.progeni.live)
# ------------------------------------------------------------------------------
# The app REFUSES payment endpoints (503) when these are unset — by design,
# because live keys must never ship in source control.
UPI_GATEWAY_URL=https://pay.progeni.live
UPI_GATEWAY_KEY=
UPI_GATEWAY_SECRET=
UPI_MERCHANT_VPA=progeniatlas@ptaxis
UPI_PAYEE_NAME=Progeni Atlas
# Auto-approve UTR recharges up to this INR amount when the gateway is unreachable.
# 0 disables the fallback (orders then stay pending_verification for review).
UPI_AUTO_APPROVE_MAX_INR=10000

# ------------------------------------------------------------------------------
# 8b. RAZORPAY  (hosted checkout — instant signature + webhook auto-credit)
# Sign up: https://razorpay.com  →  Dashboard → Settings → API Keys (Live mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → add https://api-atlas.progeni.live/api/billing/wallet/razorpay-webhook
# Events: payment.captured   | Secret: copy it here (used to validate X-Razorpay-Signature)
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 9. ATS INBOUND WEBHOOKS  (signature-verified shared secrets)
# ------------------------------------------------------------------------------
# Greenhouse / Workday POST to /api/integrations/{greenhouse,workday}/webhook
# with header X-Webhook-Secret: <the secret below>. When unset the endpoint
# answers 503 and ACCEPTS NOTHING (by design).
GREENHOUSE_WEBHOOK_SECRET=
GREENHOUSE_ORG_ID=org-default
WORKDAY_WEBHOOK_SECRET=
WORKDAY_ORG_ID=org-default

# ------------------------------------------------------------------------------
# 10. UPLOADS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
RECORDING_DIR=./recordings
MAX_CONTENT_LENGTH=52428800
# Allow PUBLIC /uploads/<file> access (resumes, recordings)? Default false.
# Only set true if you knowingly serve public assets — never for PII.
UPLOADS_ALLOW_PUBLIC=false

# ------------------------------------------------------------------------------
# 11. SUPER-ADMIN ROUTES  (see also frontend .env.example -> SUPER_ADMIN_EMAILS)
# ------------------------------------------------------------------------------
# SUPER_ADMIN_EMAILS=admin@progeni.live,founder@progeni.live
