# ==============================================================================
# TALENTPULSE AI / SWAMI INTERVIEWER — BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the application.
# Set FLASK_ENV=production when deploying to production.
PORT=5000
FLASK_ENV=development
# FLASK_DEBUG should be set to False in production.
# When FLASK_DEBUG=True and FLASK_ENV=production, debug mode is automatically disabled.
FLASK_DEBUG=False
# Session/cookie signing key for the legacy Flask app (backend/app.py).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SWAMI_SECRET_KEY=
# Token signing key read by app/config.py. Must be set or the app will not boot.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 1b. OTP PEPPER (REQUIRED — no default, no fallback)
# ------------------------------------------------------------------------------
# The OTP HMAC pepper is resolved from the FIRST of these that is set:
#   OTP_PEPPER  ->  SWAMI_SECRET_KEY  ->  JWT_SECRET
# If none of them is set the app REFUSES TO BOOT with
# "OTP_PEPPER or JWT_SECRET must be set". There is deliberately no hardcoded
# fallback value anywhere in the codebase.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse JWT_SECRET as the pepper in production: OTP hashes live in the
# database, so rotating the pepper invalidates every unconsumed OTP.
OTP_PEPPER=

# ------------------------------------------------------------------------------
# 2. LLM & AI ENGINE CONFIGURATION (Primary: OpenAI -> Fallback: Docker Ollama)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=openrouter

# OpenAI API Settings (Primary)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# OpenRouter Settings (Secondary Fallback)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Docker / Staging Ollama Settings (Final Fallback)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ------------------------------------------------------------------------------
# 3. POLYGLOT DATABASE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Relational Data & Audit Logs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=progeni_atlas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/progeni_atlas_db

# MongoDB Atlas / Local (Transcripts & Turn Evaluations)
MONGO_URI=mongodb://localhost:27017/progeni_atlas_transcripts

# Qdrant Vector Database (Resume Embeddings & Rubrics)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_RESUMES=candidate_resumes
QDRANT_COLLECTION_QUESTIONS=question_banks
QDRANT_COLLECTION_RUBRICS=job_rubrics

# ------------------------------------------------------------------------------
# 4. STORAGE & RECORDING PATHS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
RECORDING_DIR=./recordings
MAX_CONTENT_LENGTH=52428800

# ------------------------------------------------------------------------------
# 5. SMTP / EMAIL DISPATCH CONFIGURATION (OTP delivery)
# ------------------------------------------------------------------------------
# Gmail: use an App Password (not your login password).
# Port 465 = implicit SSL, Port 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Progeni Atlas
SMTP_FROM=
EMAIL_SENDER=

# ------------------------------------------------------------------------------
# 6. OTP POLICY (server is the source of truth; frontend only mirrors it)
# ------------------------------------------------------------------------------
# OTP_TTL_SEC=120
# OTP_RESEND_COOLDOWN_SEC=30
# OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 7. FRONTEND (frontend/web/.env.local)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 8. LIVEKIT WEBRTC CONFIGURATION (Server only — never expose to client)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your_livekit_api_secret_32_characters_minimum



openrouter_api_key= "openrouter_api_key"