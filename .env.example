# ==============================================================================
# TALENTPULSE AI / SWAMI INTERVIEWER — BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=True
SWAMI_SECRET_KEY=talentpulse_super_secret_jwt_key_2026_prod_change_me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. LLM & AI ENGINE CONFIGURATION (OpenAI or Local Ollama)
# ------------------------------------------------------------------------------
# LLM Provider options: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI API Settings
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Local Ollama Settings (Uncomment if LLM_PROVIDER=ollama)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.3

# ------------------------------------------------------------------------------
# 3. POLYGLOT DATABASE INFRASTRUCTURE
# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Relational Data & Audit Logs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talentpulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talentpulse_db

# MongoDB Atlas / Local (Transcripts & Turn Evaluations)
MONGO_URI=mongodb://localhost:27017/talentpulse_transcripts

# Qdrant Vector Database (Resume Embeddings & Rubrics)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_RESUMES=candidate_resumes
QDRANT_COLLECTION_QUESTIONS=question_banks
QDRANT_COLLECTION_RUBRICS=job_rubrics

# ------------------------------------------------------------------------------
# 4. STORAGE & RECORDING PATHS
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
RECORDING_DIR=./recordings
MAX_CONTENT_LENGTH=52428800

# ------------------------------------------------------------------------------
# 5. SMTP / EMAIL DISPATCH CONFIGURATION (OTP delivery)
# ------------------------------------------------------------------------------
# Gmail: use an App Password (not your login password).
# Port 465 = implicit SSL, Port 587 = STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=TalentPulse AI
SMTP_FROM=
EMAIL_SENDER=

# ------------------------------------------------------------------------------
# 6. OTP POLICY (server is the source of truth; frontend only mirrors it)
# ------------------------------------------------------------------------------
# OTP_TTL_SEC=120
# OTP_RESEND_COOLDOWN_SEC=30
# OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 7. FRONTEND (frontend/web/.env.local)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:5000

